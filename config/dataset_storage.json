{
  "download": {
    "provider": "shell",
    "credentials": {
      "download_command": [
        "bash",
        "scripts/providers/download_dataset.sh",
        "{source}",
        "{destination_dir}",
        "{destination}",
        "{tmp_dir}",
        "{download_parent_id}"
      ],
      "download_parent_id": "<REPLACE_WITH_DOWNLOAD_FOLDER_ID>"
    },
    "artifacts": [
      {
        "name": "evaluation-dataset",
        "source": "<REPLACE_WITH_DOWNLOAD_FILE_ID>",
        "destination": "evaluation",
        "unpack": true
      }
    ]
  },
  "upload": {
    "provider": "shell",
    "credentials": {
      "upload_command": [
        "bash",
        "scripts/providers/upload_dataset.sh",
        "{source_dir}",
        "{remote_path}",
        "{archive_path}",
        "{tmp_dir}",
        "{upload_parent_id}"
      ],
      "upload_parent_id": "15hldwt3XwGZmyYwF8F-xHCVkEYUzKGxi"
    },
    "artifacts": [
      {
        "name": "evaluation-dataset",
        "source": "test",
        "destination": "evaluation",
        "unpack": false
      }
    ]
  }
}

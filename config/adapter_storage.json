{
  "provider": "shell",
  "credentials": {
    "download_command": [
      "bash",
      "scripts/providers/download_adapter.sh",
      "{source}",
      "{destination_dir}",
      "{name}"
    ],
    "upload_command": [
      "bash",
      "scripts/providers/upload_adapter.sh",
      "{source_dir}",
      "{remote_path}",
      "{archive_path}"
    ]
  },
  "artifacts": [
    {
      "name": "finance-news-mistral",
      "source": "<REPLACE_WITH_FILE_ID>",
      "destination": "finance/news_classification/mistral",
      "unpack": true
    },
    {
      "name": "finance-sentiment-falcon",
      "source": "<REPLACE_WITH_FILE_ID>",
      "destination": "finance/sentiment_analysis/falcon",
      "unpack": true
    }
  ]
}
